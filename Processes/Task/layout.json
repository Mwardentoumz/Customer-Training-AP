																						"label": "",
																						"htmlContent": "<script>\n    window.postMessage({ eventName: \"onLoad\", control: \"HTMLProgressBar__\" }, document.location.origin);\n\tdocument.getElementById(\"progress\").addEventListener(\"input\", function(event)\n\t{\n\t\tvar progressValue = event.target.value;\n\t\tdocument.getElementById(\"progress\").style.backgroundSize = progressValue + '% 100%'\n\t\twindow.postMessage(\n\t\t\t{\n\t\t\t\teventName: \"onInput\",\n\t\t\t\tprogressValue: progressValue,\n\t\t\t\tcontrol: \"HTMLProgressBar__\"\n\t\t\t}, document.location.origin);\n\t});\n\tdocument.getElementById(\"progress\").addEventListener(\"mouseout\", function(event)\n\t{\n\t\tdocument.getElementById(\"progress\").blur();\n\t});\n\tfunction setProgressValue(event)\n\t{\n\t\tconst value = event.value || 0;\n\t\tdocument.getElementById(\"progress\").value = value;\n\t\tdocument.getElementById(\"progress\").style.backgroundSize = value + '% 100%';\n\t\tif (event.disabled)\n\t\t{\n\t\t\tdocument.getElementById(\"progress\").disabled = true;\n\t\t}\n\t}\n</script>\n<div>\n0%\n<input type=\"range\" id=\"progress\" class=\"progress\" min=\"0\" max=\"100\" value=\"0\" />\n100%\n</div>\n<span id=\"handler\" style=\"display: none\" onclick=\"setProgressValue(event)\"></span>",
